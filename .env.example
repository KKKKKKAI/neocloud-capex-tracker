# For LOCAL runs only: copy to .env, fill in, then `set -a; . ./.env; set +a`
# before `capex …`. .env is gitignored. The server never reads this file:
# its secrets live in SSM Parameter Store under /capex/ (deploy/README.md).

# Free Alpha Vantage key (5 calls/min, 500/day) — register at
# https://www.alphavantage.co/support/#api-key
#
# SCOPE: date discovery only. Alpha Vantage tells us WHEN companies
# will report (forward earnings dates). It is NEVER used to extract
# financial data — that is done by our own LLM dual-agent framework
# reading filings from SEC EDGAR / HKEXnews.
#
# Used by: src/capex/monitor/calendar.py (populates fiscal_calendar
# with status='upcoming' rows so the watcher knows when to poll SEC).
ALPHA_VANTAGE_API_KEY=your_key_here

# Gmail SMTP for outbound notify emails. SCOPE: outbound notifications
# only — these credentials are never used to read mail or for any other
# Gmail API.
#
# 1. Generate an "App Password" at https://myaccount.google.com/apppasswords
#    (regular Google passwords don't work for SMTP — you need the
#    16-character app-specific password).
# 2. Paste your Gmail address as GMAIL_USERNAME and the App Password
#    as GMAIL_APP_PASSWORD.
# 3. Subscribers live in the DB: `capex notify add EMAIL` (or the admin
#    panel on the server).
#
# Used by: src/capex/notify/email_sender.py
GMAIL_USERNAME=your.gmail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
