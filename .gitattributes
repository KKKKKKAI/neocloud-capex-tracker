# Line endings. The repo is checked out on Windows but driven from WSL /
# Linux, and Windows Git runs with core.autocrlf=true. Pin LF so no
# checkout can turn shell scripts into CRLF (bash then fails on '\r').
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Binary artefacts: never normalise or diff as text.
*.png  binary
*.pdf  binary
*.xlsx binary
*.db   binary
*.gz   binary
