# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ---- Excel lock and temp files ----
~$*.xlsx
~$*.xlsm
~$*.xls
*.xlsx.lock
.~lock.*#

# ---- LibreOffice temp ----
.~lock.*

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors ----
.idea/
.vscode/
# Per-user Claude Code settings (permission grants) — never shared.
.claude/settings.local.json
*.swp
*.swo
*~

# ---- Local data scratch ----
data/scratch/
data/cache/
data/_logs/
*.log
logs/

# ---- Runtime data under CAPEX_HOME (= the checkout by default) ----
# GitHub holds code only. The always-on server is the system of record:
# its DB, workbooks, charts and site live on its data volume and in S3
# (docs/SERVER_OPERATIONS.md). A local copy comes from
# scripts/pull_server_snapshot.sh. See src/capex/paths.py.
/data/db/*.db
/data/db/*.db-*
/data/db/dump.sql
/workbook/*
!/workbook/.gitkeep
/charts/
/output/
/site/
/run/
/backups/
/llm-cwd/
/docs/charts/
*.dump.sql

# Local DB rollback snapshots (taken before destructive migrations /
# bulk rewrites). They live next to capex.db so a quick `cp` can
# restore. Each is a full SQLite dump and must NOT go to the remote.
*.bak

# Personal subscriber data (notify emails). NEVER commit real emails
# to the public repo. Only data/_local/subscribers.yaml.example
# (committed) shows the schema.
data/_local/*
!data/_local/subscribers.yaml.example
!data/_local/.gitkeep

# ---- Source archive (runtime artifacts, fetched on demand) ----
# Per-ticker directories under data/_sources/ hold the raw regulator
# bytes (HTML/PDF) and the canonical year-folder copies. These are
# regeneratable from the regulator and are too large to belong in git.
# Run `capex fetch <TICKER> <FORM>` followed by `capex organize` to
# repopulate after a fresh clone.
#
# Top-level files in data/_sources/ (especially _identity.yaml and
# _organizer_log.csv) are NOT ignored — they're authoritative project
# state, not runtime artifacts.
data/_sources/*/

# ---- Internal dev artifacts ----
_patches/
