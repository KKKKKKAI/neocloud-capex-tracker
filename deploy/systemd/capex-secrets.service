[Unit]
Description=capex: load runtime secrets from SSM Parameter Store
Documentation=file:///opt/capex/src/docs/SERVER_MIGRATION_CHECKLIST.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/capex/capex.conf
# /run is tmpfs: secrets never reach the data volume.
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g capex /run/capex
ExecStart=/opt/capex/venv/bin/python -m capex.server.secrets fetch --out /run/capex/capex.env --group capex
# SSM or the instance role can lag right after boot.
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
